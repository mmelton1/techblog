---
import Base from "./Base.astro";
import { longDate, isoDate } from "@/utils/date";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  minutesRead?: string;
}

const { project, minutesRead } = Astro.props;
const { title, summary, stack, repo, link, publishDate, updatedDate } = project.data;
---

<Base title={title} description={summary}>
  <article>
    <header class="article-head">
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <time datetime={isoDate(publishDate)}>{longDate(publishDate)}</time>
        {minutesRead && <span>{minutesRead}</span>}
        {updatedDate && <span>Updated {longDate(updatedDate)}</span>}
      </div>
      {stack.length > 0 && <p class="article-stack">{stack.join(" · ")}</p>}
      {(repo || link) && (
        <div class="article-meta">
          {link && <a href={link}>Live &rarr;</a>}
          {repo && <a href={repo}>Source &rarr;</a>}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    <a class="back" href="/projects/">
      &larr; All projects
    </a>
  </article>
</Base>
