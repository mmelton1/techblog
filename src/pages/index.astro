---
import Base from "@/layouts/Base.astro";
import ProjectRecord from "@/components/ProjectRecord.astro";
import { getCollection } from "astro:content";
import { INTRO } from "@/consts";

// Home highlights the featured projects; the full list lives on /projects/.
const projects = (
  await getCollection("projects", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
)
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Base variant="home">
  <div class="intro">
    {INTRO.map((p) => (
      <p>{p}</p>
    ))}
  </div>

  <section>
    <h2 class="section-title">Projects</h2>
    {projects.map((project) => (
      <ProjectRecord project={project} />
    ))}
    <p class="more">
      <a href="/projects/">All projects &rarr;</a> &middot;{" "}
      <a href="/about/">More about me &rarr;</a>
    </p>
  </section>
</Base>
